<style>
:root{--brand:#129ad2;--brand-2:#31A6D4;--brand-dark:#0b6f9c;--navy:#07304a;--navy-2:#0a4263;--sky:#eaf6fc;--sky-2:#f5fbfe;--gold:#f5b62e;--ink:#12283a;--muted:#5b7183;--line:#dcebf3;--radius:18px;--shadow:0 18px 50px -20px rgba(7,48,74,.35)}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:84px}
html,body{overflow-x:hidden}
body{font-family:'Be Vietnam Pro',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;color:var(--ink);background:#fff;line-height:1.65;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}ul,ol{list-style:none}img,video{max-width:100%}
button{font-family:inherit;cursor:pointer;border:0;background:none}
.container{width:min(1160px,92%);margin-inline:auto}
section{padding:88px 0;position:relative}
.ic{width:20px;height:20px;flex:none;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.eyebrow{display:inline-flex;align-items:center;gap:10px;font-size:12.5px;font-weight:700;letter-spacing:.14em;color:var(--brand-dark);text-transform:uppercase;margin-bottom:14px}
.eyebrow::before{content:"";width:28px;height:2px;background:var(--gold)}
h1,h2,h3{line-height:1.22;color:var(--navy);letter-spacing:-.01em}
h2{font-size:clamp(28px,3.6vw,42px);font-weight:800;margin-bottom:14px}
.lead{color:var(--muted);font-size:17px;max-width:680px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:14px 24px;border-radius:999px;font-weight:700;font-size:15px;transition:transform .25s,background .25s,color .25s;white-space:nowrap}
.btn-primary{background:var(--brand);color:#fff;box-shadow:0 12px 26px -12px rgba(18,154,210,.75)}
.btn-primary:hover{transform:translateY(-3px);background:var(--brand-dark)}
.btn-ghost{border:1.5px solid rgba(255,255,255,.45);color:#fff}.btn-ghost:hover{background:#fff;color:var(--navy)}
.btn-outline{border:1.5px solid var(--brand);color:var(--brand-dark);background:#fff}.btn-outline:hover{background:var(--brand);color:#fff}
/* header */
.header{position:fixed;inset:0 0 auto 0;z-index:50;transition:background .3s,box-shadow .3s,padding .3s;padding:16px 0}
.header.scrolled{background:rgba(255,255,255,.96);box-shadow:0 6px 24px -14px rgba(7,48,74,.4);padding:10px 0}
.header .container{display:flex;align-items:center;justify-content:space-between;gap:20px}
.logo{display:flex;align-items:center;gap:12px;font-weight:800;color:#fff;font-size:18px}
.logo img{height:44px;width:auto;border-radius:10px;background:#fff;padding:4px}
.logo small{display:block;font-size:11px;font-weight:500;letter-spacing:.08em;opacity:.8;text-transform:uppercase;white-space:nowrap}
.header.scrolled .logo{color:var(--navy)}
.nav{display:flex;align-items:center;gap:20px;font-size:14px;font-weight:600;color:rgba(255,255,255,.9)}
.header.scrolled .nav{color:var(--ink)}
.nav a{position:relative;padding:6px 0;white-space:nowrap}
.nav a:not(.btn)::after{content:"";position:absolute;left:0;bottom:0;height:2px;width:0;background:var(--gold);transition:width .3s}
.nav a:not(.btn):hover::after{width:100%}
.nav .btn{padding:11px 20px;color:#fff}
@media(max-width:1180px){.nav a.long{display:none}}
@media(max-width:900px){.nav a:not(.btn){display:none}}
/* hero 50/50 */
.hero{background:linear-gradient(135deg,var(--navy),var(--navy-2) 70%,#0c5a82);color:#fff;padding:132px 0 88px}
.hero .container{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px;align-items:center}
.hero .container>*,.tabs>*,.media-row>*,.wrap>*{min-width:0}
.tag{display:inline-flex;align-items:center;gap:10px;padding:8px 16px;border-radius:999px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.22);font-size:12.5px;font-weight:700;letter-spacing:.12em}
.tag i{width:8px;height:8px;border-radius:50%;background:var(--gold)}
.hero h1{color:#fff;font-size:clamp(30px,3.5vw,46px);font-weight:800;margin:18px 0 16px}
.hero h1 em{font-style:normal;color:#8fdcfb}
.hero h1 span{display:block;font-size:.5em;font-weight:600;color:rgba(255,255,255,.85);margin-top:10px}
.price{display:inline-flex;align-items:baseline;gap:10px;margin-bottom:18px;padding:10px 20px;border-radius:14px;background:rgba(255,255,255,.08);border:1px dashed rgba(255,255,255,.3)}
.price b{font-size:32px;font-weight:800;color:var(--gold)}.price span{font-size:14px;opacity:.85}
.hero p{color:rgba(255,255,255,.86);font-size:16px;margin-bottom:12px}
.hero .cta{display:flex;flex-wrap:wrap;gap:14px;margin:24px 0 22px}
.chips{display:flex;flex-wrap:wrap;gap:10px}
.chips li{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:600;padding:8px 14px;border-radius:999px;background:rgba(255,255,255,.08)}
.chips .ic{width:16px;height:16px;color:var(--gold);stroke-width:3}
.hero-media{margin:0;width:100%;animation:rise 1s .2s both cubic-bezier(.2,.8,.2,1)}
@keyframes rise{from{opacity:0;transform:translateY(36px)}to{opacity:1;transform:none}}
.hero-frame{position:relative;aspect-ratio:3/2;border-radius:20px;overflow:hidden;background:linear-gradient(135deg,#0a4263,#0c5a82);box-shadow:0 30px 60px -30px rgba(0,0,0,.6)}
.hero-frame img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 35%}
.hero-frame .ph{position:absolute;inset:0;display:none;place-items:center;text-align:center;padding:24px;color:rgba(255,255,255,.85);font-weight:700}
.hero-frame.noimg img{display:none}.hero-frame.noimg .ph{display:grid}
.hero-check{position:relative;background:#fff;color:var(--ink);border-radius:18px;padding:16px;margin:-30px 16px 0;box-shadow:0 24px 50px -24px rgba(0,0,0,.5)}
.check-title{font-weight:700;color:var(--navy);margin-bottom:10px;font-size:15px}
.check-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}
.check-grid div{display:flex;flex-direction:column;align-items:center;gap:6px;padding:10px 4px;border-radius:12px;background:var(--sky);font-weight:600;font-size:13px;text-align:center}
.check-grid .ic{color:var(--brand)}
.hero-media figcaption{font-size:12.5px;line-height:1.55;color:rgba(255,255,255,.75);margin:12px 4px 0}
@media(max-width:960px){.hero{padding:112px 0 64px}.hero .container{grid-template-columns:minmax(0,1fr);gap:36px}.hero h1{font-size:clamp(30px,7vw,40px)}}
@media(max-width:480px){.check-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.hero .cta .btn{width:100%}}
/* reveal */
.reveal{opacity:0;transform:translateY(34px);transition:opacity .8s cubic-bezier(.2,.8,.2,1),transform .8s cubic-bezier(.2,.8,.2,1);transition-delay:var(--d,0s)}
.reveal.in{opacity:1;transform:none}
.bg{background:var(--sky-2)}
/* tabs */
.tabs{display:grid;grid-template-columns:320px minmax(0,1fr);gap:28px;margin-top:44px}
.tab-list{display:flex;flex-direction:column;gap:8px}
.tab-btn{display:flex;align-items:center;gap:14px;text-align:left;padding:15px 18px;border-radius:14px;font-weight:600;font-size:15px;color:var(--ink);background:#fff;border:1px solid var(--line);transition:all .25s}
.tab-btn span{font-size:12.5px;font-weight:800;color:var(--brand);width:26px}
.tab-btn:hover{transform:translateX(6px);border-color:var(--brand-2)}
.tab-btn.active{background:var(--brand);color:#fff;border-color:transparent}.tab-btn.active span{color:var(--gold)}
.tab-panel{background:#fff;border-radius:24px;padding:38px;border:1px solid var(--line);box-shadow:var(--shadow);min-height:440px}
.swap{animation:swap .5s cubic-bezier(.2,.8,.2,1)}
@keyframes swap{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}
.panel-top{display:flex;justify-content:space-between;font-size:12.5px;font-weight:700;letter-spacing:.14em;color:var(--muted);margin-bottom:18px}
.panel-top b{color:var(--brand)}
.kicker{font-weight:700;color:var(--brand-dark);font-size:14.5px}
.tab-panel h3{font-size:clamp(22px,2.6vw,30px);font-weight:800;margin:6px 0 10px}
.tab-panel>p{color:var(--muted);margin-bottom:20px}
.tab-panel ul{display:grid;gap:12px;margin-bottom:24px}
.tab-panel li{position:relative;padding-left:26px;font-size:15.5px}
.tab-panel li::before{content:"✓";position:absolute;left:0;color:var(--brand);font-weight:800}
.result{padding:18px 20px;border-radius:16px;background:#fffaf0;border:1px solid #f6e2ae;margin-bottom:24px}
.result small{display:block;font-size:12px;font-weight:800;letter-spacing:.12em;color:#a8780c;text-transform:uppercase}
.result p{font-weight:600;color:var(--navy)}
@media(max-width:900px){.tabs{grid-template-columns:minmax(0,1fr)}.tab-list{flex-direction:row;overflow-x:auto;padding-bottom:8px}.tab-btn{flex:none}.tab-btn:hover{transform:none}.tab-panel{padding:26px}}
/* cards */
.grid-3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;margin-top:40px}
.grid-2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin-top:26px}
.card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:28px;transition:transform .35s,box-shadow .35s,border-color .35s}
.card:hover{transform:translateY(-6px);box-shadow:var(--shadow);border-color:var(--brand-2)}
.num{font-size:15px;font-weight:800;letter-spacing:.1em;color:var(--brand);margin-bottom:10px}
.card h3{font-size:18.5px;margin-bottom:6px}
.card small{display:block;color:var(--brand-dark);font-weight:600;font-size:13.5px;margin-bottom:8px}
.card p{color:var(--muted);font-size:15px}
@media(max-width:900px){.grid-3,.grid-2{grid-template-columns:minmax(0,1fr)}}
/* gallery */
.media-row{display:grid;grid-template-columns:1.2fr .85fr 1.15fr;gap:18px;margin-top:40px}
.tile{position:relative;margin:0;height:460px;border-radius:18px;overflow:hidden;background:#06263a;box-shadow:var(--shadow)}
.tile img,.tile video{display:block;width:100%;height:100%}
.tile img{object-fit:cover;cursor:zoom-in;transition:transform .6s}.tile:hover img{transform:scale(1.04)}
.tile video{object-fit:contain;background:#000}
.tile figcaption{position:absolute;left:0;right:0;bottom:0;padding:40px 16px 14px;background:linear-gradient(transparent,rgba(5,31,49,.88));color:#fff;font-size:13.5px;pointer-events:none}
.tile.video figcaption{top:0;bottom:auto;padding:14px 16px 40px;background:linear-gradient(rgba(5,31,49,.8),transparent)}
.small{margin-top:18px;font-size:13.5px;color:var(--muted)}
@media(max-width:900px){.media-row{grid-template-columns:minmax(0,1fr)}.tile{height:auto}.tile img{height:auto}.tile video{height:auto;max-height:72vh}}
/* dark sections */
.dark{background:linear-gradient(160deg,var(--navy),var(--navy-2));color:#fff}
.dark h2,.dark h3{color:#fff}.dark .lead{color:rgba(255,255,255,.8)}.dark .eyebrow{color:#8fdcfb}
.head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap}
.acts{display:flex;gap:12px;flex-wrap:wrap}
.step{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);border-radius:var(--radius);padding:28px;transition:transform .35s,background .35s}
.step:hover{transform:translateY(-8px);background:rgba(255,255,255,.11)}
.step i{display:grid;place-items:center;width:56px;height:56px;border-radius:50%;font-style:normal;font-weight:800;font-size:22px;background:var(--brand);margin-bottom:18px}
.step h3{font-size:19px;margin-bottom:8px}.step p{color:rgba(255,255,255,.78);font-size:15px}
/* self */
.wrap{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:50px;align-items:start}
.official{margin-top:26px;padding:22px;border-radius:18px;background:var(--sky);border:1px solid var(--line)}
.official p{font-size:13.5px;color:var(--muted);margin-top:10px}
.timeline{display:grid;gap:16px}
.tl{display:flex;gap:18px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:20px 22px;transition:transform .3s,box-shadow .3s}
.tl:hover{transform:translateX(8px);box-shadow:var(--shadow)}
.tl b{flex:none;width:48px;height:48px;border-radius:14px;background:var(--navy);color:#fff;display:grid;place-items:center}
.tl h3{font-size:17.5px;margin-bottom:4px}.tl p{font-size:14.5px;color:var(--muted)}
.disclaimer{margin-top:28px;padding:18px 22px;border-left:4px solid var(--gold);background:#fffaf0;border-radius:0 14px 14px 0;font-size:14.5px;color:#5c4a1c}
@media(max-width:900px){.wrap{grid-template-columns:minmax(0,1fr)}}
/* tax */
.sub-h{font-size:22px;font-weight:800;margin-top:50px}
.notice{margin:26px 0;padding:20px 24px;border-radius:16px;background:var(--brand-dark);color:#fff;font-size:15px}
.refs{margin-top:30px;padding:24px;border-radius:16px;border:1px dashed #b9d9e8;background:#fff}
.refs h4{font-size:14px;letter-spacing:.08em;text-transform:uppercase;color:var(--brand-dark);margin-bottom:12px}
.refs ul{display:grid;grid-template-columns:1fr 1fr;gap:8px 24px;font-size:14.5px;color:var(--muted)}
@media(max-width:900px){.refs ul{grid-template-columns:1fr}}
/* faq */
.center{text-align:center}.center .lead{margin-inline:auto}
.faq-list{max-width:860px;margin:40px auto 0;display:grid;gap:12px}
.faq{border:1px solid var(--line);border-radius:16px;background:#fff;transition:box-shadow .3s,border-color .3s}
.faq[open]{box-shadow:var(--shadow);border-color:var(--brand-2)}
.faq summary{display:flex;align-items:center;gap:16px;padding:20px 22px;font-weight:700;font-size:16.5px;color:var(--navy);cursor:pointer;list-style:none}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:"+";margin-left:auto;flex:none;width:30px;height:30px;border-radius:50%;background:var(--sky);display:grid;place-items:center;color:var(--brand-dark);transition:transform .3s}
.faq[open] summary::after{transform:rotate(45deg);background:var(--brand);color:#fff}
.faq p{padding:0 22px 22px;color:var(--muted);font-size:15.5px;animation:swap .4s}
/* contact */
.info li{display:flex;gap:14px;padding:14px 0;border-bottom:1px solid rgba(255,255,255,.12);font-size:15px;color:rgba(255,255,255,.88)}
.info .ic{margin-top:3px;color:var(--gold)}.info b{color:#fff}
form{background:#fff;color:var(--ink);border-radius:24px;padding:34px;box-shadow:0 40px 80px -30px rgba(0,0,0,.5)}
form h3{font-size:22px;margin-bottom:6px;color:var(--navy)}
form>p{font-size:14px;color:var(--muted);margin-bottom:20px}
.field{margin-bottom:14px}
.field label{display:block;font-size:13.5px;font-weight:600;margin-bottom:6px}
.field input,.field select,.field textarea{width:100%;padding:13px 15px;border:1.5px solid var(--line);border-radius:12px;font:inherit;font-size:16px;color:var(--ink);background:var(--sky-2);transition:border-color .25s,box-shadow .25s}
.field :focus{outline:0;border-color:var(--brand);box-shadow:0 0 0 4px rgba(18,154,210,.15)}
.consent{display:flex;gap:10px;font-size:13px;color:var(--muted);margin:6px 0 18px}
.consent input{margin-top:4px;accent-color:var(--brand);flex:none}
.consent a{color:var(--brand-dark);text-decoration:underline}
form .btn{width:100%}
.warn{font-size:12.5px;color:var(--muted);margin-top:14px;text-align:center}
.form-msg{display:none;margin-top:14px;padding:12px 16px;border-radius:12px;font-size:14.5px;font-weight:600}
/* footer */
footer{background:#051f31;color:rgba(255,255,255,.72);padding:54px 0 96px;font-size:14.5px}
footer h4{color:#fff;font-size:15px;margin-bottom:14px}
footer li{margin-bottom:8px}
footer a:hover,footer button:hover{color:#fff;text-decoration:underline}
footer button{color:inherit;font-size:inherit;text-align:left}
.legal{margin-top:34px;padding-top:22px;border-top:1px solid rgba(255,255,255,.12);font-size:13.5px;display:grid;gap:10px}
.legal strong{color:#fff}
/* floating */
.mobile-bar{position:fixed;left:0;right:0;bottom:0;z-index:60;display:none;grid-template-columns:1fr 1fr 1.4fr;background:#fff;box-shadow:0 -8px 24px -10px rgba(7,48,74,.35)}
.mobile-bar a{padding:14px 6px;text-align:center;font-weight:700;font-size:14px;color:var(--navy)}
.mobile-bar a:last-child{background:var(--brand);color:#fff}
.fab{position:fixed;right:22px;bottom:26px;z-index:55;display:grid;gap:12px}
.fab a{width:54px;height:54px;border-radius:50%;display:grid;place-items:center;color:#fff;box-shadow:0 12px 26px -8px rgba(7,48,74,.6);transition:transform .25s;position:relative}
.fab a:hover{transform:scale(1.1)}
.fab .call{background:var(--brand)}
.fab .call::before{content:"";position:absolute;inset:0;border-radius:50%;border:2px solid var(--brand);animation:ring 2s infinite}
@keyframes ring{to{transform:scale(1.7);opacity:0}}
.fab .zalo{background:#0068ff;font-weight:800;font-size:13px}
@media(max-width:700px){.mobile-bar{display:grid}.fab{display:none}section{padding:64px 0}}
/* modal */
.modal{position:fixed;inset:0;z-index:100;background:rgba(5,31,49,.78);display:none;align-items:center;justify-content:center;padding:20px}
.modal.show{display:flex}
.modal-box{background:#fff;border-radius:22px;max-width:720px;width:100%;max-height:88vh;overflow:auto;padding:36px;position:relative;animation:swap .4s}
.modal-box h3{font-size:24px;margin-bottom:14px}
